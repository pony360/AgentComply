{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcomply.io/schemas/policy-v1alpha1.schema.json",
  "title": "AgentComply policy v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agentcomply.io/v1alpha1" },
    "kind": { "const": "AgentSecurityPolicy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultAction", "rules"],
      "properties": {
        "defaultAction": { "const": "deny" },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agentIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$" }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["monitor", "enforce"] },
            "sources": {
              "type": "array",
              "items": {
                "enum": ["rag_document", "tool_response", "external_web", "user_input", "memory"]
              }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "redactSecrets": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "tool", "operations", "resourcePatterns"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$" },
        "effect": { "enum": ["allow", "deny", "require_approval"] },
        "tool": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$" }
        },
        "resourcePatterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.\\-*/]{1,512}$" }
        },
        "requiredTaskScopes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$" }
        }
      }
    }
  }
}
